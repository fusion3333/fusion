EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# 서버 전용 - 실제 값은 로컬/배포 환경변수에만 저장하세요.
DATA_GO_KR_SERVICE_KEY=

# 선택사항: 직접 정규화 JSON을 쓸 때만 설정. 비우면 경기북부 범죄는 승인된 odcloud OpenAPI를 직접 호출합니다.
CRIME_DATA_URL=

# 주민등록 총인구 provider의 검증된 스냅샷 URL을 사용할 때만 설정.
POPULATION_DATA_URL=

CORS_ORIGIN=http://localhost:8081,http://localhost:19006
INTERNAL_JOB_TOKEN=change-me-to-a-long-random-secret
SUBSCRIPTIONS_FILE=./data/subscriptions.json
